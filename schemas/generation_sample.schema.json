{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nativeMLLM/evaluate_framework/generation_sample.schema.json",
  "title": "Unified Generation Benchmark Sample",
  "type": "object",
  "required": ["uid", "benchmark", "prompt", "stage", "expected_outputs", "metadata"],
  "properties": {
    "uid": {"type": "string"},
    "benchmark": {"type": "string"},
    "prompt": {"type": "string"},
    "stage": {"type": "string"},
    "expected_outputs": {"type": "integer", "minimum": 1},
    "task": {"type": "string"},
    "media": {"type": "array", "items": {"type": "object"}},
    "metadata": {"type": "object"},
    "answer": {"type": "object"},
    "extra": {"type": "object"}
  },
  "additionalProperties": true
}

