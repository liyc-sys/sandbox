{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nativeMLLM/evaluate_framework/unified_sample.schema.json",
  "title": "Unified Vision Benchmark Sample",
  "type": "object",
  "required": [
    "uid",
    "benchmark",
    "split",
    "task_type",
    "prompt",
    "media",
    "answer",
    "metadata",
    "source"
  ],
  "properties": {
    "uid": {
      "type": "string"
    },
    "benchmark": {
      "type": "string"
    },
    "subset": {
      "type": [
        "string",
        "null"
      ]
    },
    "split": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "qa",
        "yes_no",
        "multiple_choice",
        "mixed_qa",
        "grounding",
        "document_parse"
      ]
    },
    "prompt": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choice_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instruction": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "pdf"
            ]
          },
          "path": {
            "type": "string"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          },
          "page_index": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text",
            "choice",
            "number",
            "bbox",
            "structured"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "choice": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          }
        },
        "structured": {
          "type": [
            "object",
            "array",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "type": "string"
        },
        "dataset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "type": [
            "string",
            "null"
          ]
        },
        "split": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_index": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
